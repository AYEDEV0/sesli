{
  "name": "sesli-livekit-chat",
  "version": "1.0.2",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder",
    "electron:publish": "next build && electron-builder --publish never"
  },
  "build": {
    "appId": "com.voxa.app",
    "productName": "Voxa Desktop",
    "publish": {
      "provider": "github",
      "owner": "AYEDEV0",
      "repo": "sesli",
      "releaseType": "release"
    },
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@livekit/components-react": "^2.6.4",
    "@livekit/components-styles": "^1.1.4",
    "@livekit/krisp-noise-filter": "^0.4.5",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "livekit-client": "^2.5.9",
    "livekit-server-sdk": "^2.6.0",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "wait-on": "^9.1.0"
  }
}
