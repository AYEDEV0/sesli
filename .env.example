# ==========================================================
# VOXA - ÇOKLU LIVEKIT API HAVUZU (MULTI-ACCOUNT POOL)
# ==========================================================

# 1. LiveKit Hesabı
LIVEKIT_API_KEY_1=your_livekit_api_key_1
LIVEKIT_API_SECRET_1=your_livekit_api_secret_1
LIVEKIT_URL_1=wss://your-first-project.livekit.cloud
# Kotası dolduğunda true yapın (veya sistem otomatik yakalar):
LIVEKIT_EXHAUSTED_1=false

# 2. LiveKit Hesabı
LIVEKIT_API_KEY_2=your_livekit_api_key_2
LIVEKIT_API_SECRET_2=your_livekit_api_secret_2
LIVEKIT_URL_2=wss://your-second-project.livekit.cloud
LIVEKIT_EXHAUSTED_2=false

# 3. LiveKit Hesabı
LIVEKIT_API_KEY_3=your_livekit_api_key_3
LIVEKIT_API_SECRET_3=your_livekit_api_secret_3
LIVEKIT_URL_3=wss://your-third-project.livekit.cloud
LIVEKIT_EXHAUSTED_3=false

# Varsayılan LiveKit WebSocket URL
NEXT_PUBLIC_LIVEKIT_URL=wss://your-first-project.livekit.cloud

# ==========================================================
# İSTEĞE BAĞLI: VERCEL KV / UPSTASH REDIS
# ==========================================================
# Vercel Dashboard -> Storage -> Create Database -> KV
# Tanımlanırsa oda atamaları milisaniyede önbellekten okunur.
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=AX...

# ==========================================================
# GENEL UYGULAMA AYARLARI
# ==========================================================
NEXT_PUBLIC_APP_URL=https://ses.app.noticq.com
DESKTOP_DOWNLOAD_URL=https://github.com/AYEDEV0/sesli/releases
